```js
export function saveUploadedApk(buf, filename) {
  const name = String(filename || 'app.apk').replace(/[^\w.-]/g, '_');
  if (buf.length < 1000 || buf[0] !== 0x50 || buf[1] !== 0x4b) throw new Error('not an APK');
  fs.mkdirSync(dir(), { recursive: true });
  const file = name;
  const cur = apkInfo();
  fs.writeFileSync(path.join(dir(), file + '.tmp'), buf);
  fs.renameSync(path.join(dir(), file + '.tmp'), path.join(dir(), file));
  const meta = { id: `upload:${Date.now()}`, file, name, size: buf.length, tag: 'upload', title: name,
    version: (name.match(/v?(\d+(?:\.\d+)+)/) || [])[1] || 'upload', source: 'upload', fetchedAt: Date.now() };
  fs.writeFileSync(metaFile(), JSON.stringify(meta, null, 2));
  if (cur && cur.file !== file) fs.rmSync(path.join(dir(), cur.file), { force: true });
  // persist source mode = upload
  setSource({ mode: 'upload' });
  console.log(`[apk] uploaded ${meta.name}`);
  return meta;
}
```

